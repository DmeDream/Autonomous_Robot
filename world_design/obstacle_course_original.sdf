<?xml version="1.0"?>
<sdf version="1.10">
  <world name="obstacle_course">
    <physics name="default" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.75 0.82 0.90 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><direction>-0.4 0.2 -0.9</direction><diffuse>0.9 0.9 0.9 1</diffuse></light>
    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><box><size>20 16 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 16 0.1</size></box></geometry><material><diffuse>0.48 0.50 0.52 1</diffuse></material></visual></link></model>
    <model name="boundary_walls"><static>true</static><link name="walls">
      <collision name="north"><pose>0 8 0.75 0 0 0</pose><geometry><box><size>20 0.2 1.5</size></box></geometry></collision><visual name="north_v"><pose>0 8 0.75 0 0 0</pose><geometry><box><size>20 0.2 1.5</size></box></geometry><material><diffuse>0.2 0.25 0.3 1</diffuse></material></visual>
      <collision name="south"><pose>0 -8 0.75 0 0 0</pose><geometry><box><size>20 0.2 1.5</size></box></geometry></collision><visual name="south_v"><pose>0 -8 0.75 0 0 0</pose><geometry><box><size>20 0.2 1.5</size></box></geometry><material><diffuse>0.2 0.25 0.3 1</diffuse></material></visual>
      <collision name="east"><pose>10 0 0.75 0 0 0</pose><geometry><box><size>0.2 16 1.5</size></box></geometry></collision><visual name="east_v"><pose>10 0 0.75 0 0 0</pose><geometry><box><size>0.2 16 1.5</size></box></geometry><material><diffuse>0.2 0.25 0.3 1</diffuse></material></visual>
      <collision name="west"><pose>-10 0 0.75 0 0 0</pose><geometry><box><size>0.2 16 1.5</size></box></geometry></collision><visual name="west_v"><pose>-10 0 0.75 0 0 0</pose><geometry><box><size>0.2 16 1.5</size></box></geometry><material><diffuse>0.2 0.25 0.3 1</diffuse></material></visual>
    </link></model>
    <model name="maze_walls"><static>true</static><link name="walls">
      <collision name="wall_1"><pose>-4 3 0.6 0 0 0</pose><geometry><box><size>5 0.3 1.2</size></box></geometry></collision><visual name="wall_1_v"><pose>-4 3 0.6 0 0 0</pose><geometry><box><size>5 0.3 1.2</size></box></geometry><material><diffuse>0.15 0.45 0.75 1</diffuse></material></visual>
      <collision name="wall_2"><pose>2.5 3 0.6 0 0 0</pose><geometry><box><size>4.5 0.3 1.2</size></box></geometry></collision><visual name="wall_2_v"><pose>2.5 3 0.6 0 0 0</pose><geometry><box><size>4.5 0.3 1.2</size></box></geometry><material><diffuse>0.15 0.45 0.75 1</diffuse></material></visual>
      <collision name="wall_3"><pose>5 -2 0.6 0 0 0</pose><geometry><box><size>0.3 6 1.2</size></box></geometry></collision><visual name="wall_3_v"><pose>5 -2 0.6 0 0 0</pose><geometry><box><size>0.3 6 1.2</size></box></geometry><material><diffuse>0.15 0.45 0.75 1</diffuse></material></visual>
      <collision name="wall_4"><pose>-4.5 -4 0.6 0 0 0</pose><geometry><box><size>0.3 4 1.2</size></box></geometry></collision><visual name="wall_4_v"><pose>-4.5 -4 0.6 0 0 0</pose><geometry><box><size>0.3 4 1.2</size></box></geometry><material><diffuse>0.15 0.45 0.75 1</diffuse></material></visual>
    </link></model>
    <model name="crates"><static>true</static><link name="link">
      <collision name="c1"><pose>1 -3 0.5 0 0 0.25</pose><geometry><box><size>1.2 1.2 1</size></box></geometry></collision><visual name="c1_v"><pose>1 -3 0.5 0 0 0.25</pose><geometry><box><size>1.2 1.2 1</size></box></geometry><material><diffuse>0.65 0.35 0.1 1</diffuse></material></visual>
      <collision name="c2"><pose>7 4.8 0.75 0 0 -0.2</pose><geometry><box><size>1.5 1 1.5</size></box></geometry></collision><visual name="c2_v"><pose>7 4.8 0.75 0 0 -0.2</pose><geometry><box><size>1.5 1 1.5</size></box></geometry><material><diffuse>0.65 0.35 0.1 1</diffuse></material></visual>
      <collision name="c3"><pose>-7 -5.5 0.4 0 0 0.4</pose><geometry><box><size>1 1.6 0.8</size></box></geometry></collision><visual name="c3_v"><pose>-7 -5.5 0.4 0 0 0.4</pose><geometry><box><size>1 1.6 0.8</size></box></geometry><material><diffuse>0.65 0.35 0.1 1</diffuse></material></visual>
    </link></model>
    <model name="pillar_1"><static>true</static><pose>-7 5.5 0 0 0 0</pose><link name="link"><collision name="collision"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.55</radius><length>1.5</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.55</radius><length>1.5</length></cylinder></geometry><material><diffuse>0.85 0.75 0.1 1</diffuse></material></visual></link></model>
    <model name="pillar_2"><static>true</static><pose>7 -5.5 0 0 0 0</pose><link name="link"><collision name="collision"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.7</radius><length>1.5</length></cylinder></geometry></collision><visual name="visual"><pose>0 0 0.75 0 0 0</pose><geometry><cylinder><radius>0.7</radius><length>1.5</length></cylinder></geometry><material><diffuse>0.85 0.75 0.1 1</diffuse></material></visual></link></model>
  </world>
</sdf>
